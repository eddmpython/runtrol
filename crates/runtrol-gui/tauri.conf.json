{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "runtrol",
  "version": "0.0.0",
  "identifier": "dev.runtrol.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ui run build",
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "ui/dist"
  },
  "bundle": {
    "icon": ["../../assets/brand/favicon.ico"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "runtrol",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  }
}
