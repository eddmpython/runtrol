{
  "name": "@runtrol/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "check": "prettier --check README.md package.json tsconfig.json vitest.config.ts wrangler.jsonc src test && wrangler types --include-runtime=false --check && tsc --noEmit && vitest run --maxWorkers=1 --no-isolate",
    "test": "vitest run --maxWorkers=1 --no-isolate",
    "types": "wrangler types --include-runtime=false"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260813.1",
    "@types/node": "22.15.17",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
