{
  "name": "runtrol-studio",
  "displayName": "Runtrol Studio",
  "description": "Control every local coding-agent CLI session from one VS Code window.",
  "version": "0.1.0",
  "publisher": "runtrol",
  "license": "SEE LICENSE IN resources/LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/eddmpython/runtrol.git"
  },
  "homepage": "https://eddmpython.github.io/runtrol/",
  "bugs": {
    "url": "https://github.com/eddmpython/runtrol/issues"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0B0D0F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "coding agent",
    "multi agent",
    "session",
    "workspace"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "activationEvents": [
    "onView:runtrol.sessions",
    "onView:runtrol.providers",
    "onView:runtrol.conversation",
    "onCommand:runtrol.refresh",
    "onCommand:runtrol.switchSession",
    "onCommand:runtrol.startSession",
    "onCommand:runtrol.selectSession",
    "onCommand:runtrol.openWorkspace",
    "onCommand:runtrol.interrupt",
    "onCommand:runtrol.closeSession"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runtrol",
          "title": "Runtrol",
          "icon": "resources/symbol.svg"
        }
      ]
    },
    "views": {
      "runtrol": [
        {
          "id": "runtrol.sessions",
          "name": "Sessions"
        },
        {
          "id": "runtrol.providers",
          "name": "Installed CLIs"
        },
        {
          "id": "runtrol.conversation",
          "name": "Active Session",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "runtrol.refresh",
        "title": "Runtrol: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "runtrol.switchSession",
        "title": "Runtrol: Switch Session",
        "icon": "$(search)"
      },
      {
        "command": "runtrol.startSession",
        "title": "Runtrol: Start Session",
        "icon": "$(add)"
      },
      {
        "command": "runtrol.selectSession",
        "title": "Runtrol: Focus Session"
      },
      {
        "command": "runtrol.openWorkspace",
        "title": "Runtrol: Open Session Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "runtrol.interrupt",
        "title": "Runtrol: Interrupt Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "runtrol.closeSession",
        "title": "Runtrol: Close Session",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "runtrol.switchSession",
          "when": "view == runtrol.sessions",
          "group": "navigation@1"
        },
        {
          "command": "runtrol.startSession",
          "when": "view == runtrol.sessions",
          "group": "navigation@2"
        },
        {
          "command": "runtrol.refresh",
          "when": "view == runtrol.sessions || view == runtrol.providers",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "runtrol.openWorkspace",
          "when": "view == runtrol.sessions && viewItem == runtrol.session",
          "group": "inline@1"
        },
        {
          "command": "runtrol.closeSession",
          "when": "view == runtrol.sessions && viewItem == runtrol.session",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Runtrol",
      "properties": {
        "runtrol.corePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to a runtrol executable. The bundled core and PATH are discovered automatically when empty."
        },
        "runtrol.followWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Open the selected session's workspace or worktree in this window."
        }
      }
    }
  },
  "scripts": {
    "build": "node tooling/build.mjs",
    "check": "tsc --noEmit",
    "test": "node tooling/test.mjs",
    "test:host": "node tooling/extension-host.mjs",
    "package:native": "node tooling/package.mjs",
    "package:win32-x64": "node tooling/package.mjs win32-x64"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.3-5",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
