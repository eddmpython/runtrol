{
  "name": "runtrol-studio",
  "displayName": "Runtrol Studio",
  "description": "Control every local coding-agent CLI session from one VS Code window.",
  "version": "0.0.0",
  "publisher": "runtrol",
  "license": "SEE LICENSE IN resources/LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/eddmpython/runtrol.git"
  },
  "homepage": "https://eddmpython.github.io/runtrol/",
  "bugs": {
    "url": "https://github.com/eddmpython/runtrol/issues"
  },
  "pricing": "Free",
  "badges": [
    {
      "url": "https://github.com/eddmpython/runtrol/actions/workflows/vscode-release.yml/badge.svg",
      "href": "https://github.com/eddmpython/runtrol/actions/workflows/vscode-release.yml",
      "description": "VS Code release status"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/runtrol.runtrol-studio",
      "href": "https://marketplace.visualstudio.com/items?itemName=runtrol.runtrol-studio",
      "description": "Marketplace version"
    }
  ],
  "galleryBanner": {
    "color": "#0B0D0F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "agent manager",
    "ai agent",
    "chat",
    "cli",
    "coding agent",
    "coding assistant",
    "developer tools",
    "multi agent",
    "session",
    "session manager",
    "workspace",
    "worktree"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runtrol starts local coding-agent CLI processes that can change the selected repository. Trust the workspace before opening chats."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Runtrol requires a local filesystem workspace for provider CLI processes, repositories, and worktrees."
    }
  },
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "activationEvents": [
    "onView:runtrol.sessions",
    "onView:runtrol.missions",
    "onCommand:runtrol.refresh",
    "onCommand:runtrol.restartExtensionHost",
    "onCommand:runtrol.checkProviderUpdates",
    "onCommand:runtrol.fixService",
    "onCommand:runtrol.discoverServices",
    "onCommand:runtrol.remoteConnectionStatus",
    "onCommand:runtrol.pairPhone",
    "onCommand:runtrol.reviewPhonePairings",
    "onCommand:runtrol.managePhones",
    "onCommand:runtrol.reviewIntegrations",
    "onCommand:runtrol.manageIntegrations",
    "onCommand:runtrol.reviewRuntimeRequests",
    "onCommand:runtrol.openNextWaiting",
    "onCommand:runtrol.switchSession",
    "onCommand:runtrol.startSession",
    "onCommand:runtrol.alsoAsk",
    "onCommand:runtrol.startConfiguredSession",
    "onCommand:runtrol.newConfiguredConversationInProject",
    "onCommand:runtrol.selectSession",
    "onCommand:runtrol.openConversation",
    "onCommand:runtrol.renameSession",
    "onCommand:runtrol.openWorkspace",
    "onCommand:runtrol.interrupt",
    "onCommand:runtrol.closeSession",
    "onCommand:runtrol.fanOutInstruction",
    "onCommand:runtrol.validateMission",
    "onCommand:runtrol.registerMissionGate",
    "onCommand:runtrol.openMission",
    "onCommand:runtrol.startMission",
    "onCommand:runtrol.scheduleMission",
    "onCommand:runtrol.cancelMissionSchedule",
    "onCommand:runtrol.continueMission",
    "onCommand:runtrol.armMissionAutoFlight",
    "onCommand:runtrol.disarmMissionAutoFlight",
    "onCommand:runtrol.continueReadyMissions",
    "onCommand:runtrol.reviewMissionLanding",
    "onCommand:runtrol.launchFleet",
    "onCommand:runtrol.prepareMissionTask",
    "onCommand:runtrol.sendTaskInstruction",
    "onCommand:runtrol.verifyMissionTask",
    "onCommand:runtrol.retryMissionTask",
    "onCommand:runtrol.recoverInterruptedMission",
    "onCommand:runtrol.pauseMission",
    "onCommand:runtrol.resumeMission",
    "onCommand:runtrol.cancelMission",
    "onCommand:runtrol.completeMissionIntegration",
    "onCommand:runtrol.compareMissionResults",
    "onCommand:runtrol.archiveMission",
    "onCommand:runtrol.openTaskSession",
    "onCommand:runtrol.proposeCapability",
    "onCommand:runtrol.capabilityInbox",
    "onCommand:runtrol.verifyCapability",
    "onCommand:runtrol.approveCapability",
    "onCommand:runtrol.rejectCapability",
    "onCommand:runtrol.quarantineCapability",
    "onCommand:runtrol.rollbackCapability",
    "onCommand:runtrol.archiveCapability",
    "onCommand:runtrol.archiveConversation",
    "onCommand:runtrol.deleteConversation",
    "onCommand:runtrol.pinConversation",
    "onCommand:runtrol.unpinConversation",
    "onCommand:runtrol.enableAgentTools",
    "onCommand:runtrol.disableAgentTools"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runtrol",
          "title": "Runtrol",
          "icon": "resources/symbol.svg"
        }
      ],
      "panel": [
        {
          "id": "runtrolPanel",
          "title": "Chat",
          "icon": "resources/provider-icons/sparkle.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "runtrolSide",
          "title": "Chat",
          "icon": "resources/provider-icons/sparkle.svg"
        }
      ]
    },
    "views": {
      "runtrol": [
        {
          "id": "runtrol.sessions",
          "name": "Conversations"
        },
        {
          "id": "runtrol.missions",
          "name": "Missions",
          "visibility": "collapsed"
        },
        {
          "id": "runtrol.usage",
          "name": "Agent Usage",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "runtrolPanel": [
        {
          "id": "runtrol.conversationPanel",
          "name": "Chat",
          "type": "webview",
          "icon": "resources/provider-icons/sparkle.svg"
        }
      ],
      "runtrolSide": [
        {
          "id": "runtrol.conversationSide",
          "name": "Chat",
          "type": "webview",
          "icon": "resources/provider-icons/sparkle.svg"
        }
      ]
    },
