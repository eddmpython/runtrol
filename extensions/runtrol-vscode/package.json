{
  "name": "runtrol-studio",
  "displayName": "Runtrol Studio",
  "description": "Control every local coding-agent CLI session from one VS Code window.",
  "version": "0.0.0",
  "publisher": "runtrol",
  "license": "SEE LICENSE IN resources/LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/eddmpython/runtrol.git"
  },
  "homepage": "https://eddmpython.github.io/runtrol/",
  "bugs": {
    "url": "https://github.com/eddmpython/runtrol/issues"
  },
  "pricing": "Free",
  "badges": [
    {
      "url": "https://github.com/eddmpython/runtrol/actions/workflows/vscode-release.yml/badge.svg",
      "href": "https://github.com/eddmpython/runtrol/actions/workflows/vscode-release.yml",
      "description": "VS Code release status"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/runtrol.runtrol-studio",
      "href": "https://marketplace.visualstudio.com/items?itemName=runtrol.runtrol-studio",
      "description": "Marketplace version"
    }
  ],
  "galleryBanner": {
    "color": "#0B0D0F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "agent manager",
    "ai agent",
    "chat",
    "cli",
    "coding agent",
    "coding assistant",
    "developer tools",
    "multi agent",
    "session",
    "session manager",
    "workspace",
    "worktree"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runtrol starts local coding-agent CLI processes that can change the selected repository. Trust the workspace before opening chats."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Runtrol requires a local filesystem workspace for provider CLI processes, repositories, and worktrees."
    }
  },
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "activationEvents": [
    "onView:runtrol.sidebar",
    "onCommand:runtrol.refresh",
    "onCommand:runtrol.restartExtensionHost",
    "onCommand:runtrol.checkProviderUpdates",
    "onCommand:runtrol.fixService",
    "onCommand:runtrol.setUpServices",
    "onCommand:runtrol.remoteConnectionStatus",
    "onCommand:runtrol.pairPhone",
    "onCommand:runtrol.reviewPhonePairings",
    "onCommand:runtrol.managePhones",
    "onCommand:runtrol.reviewIntegrations",
    "onCommand:runtrol.manageIntegrations",
    "onCommand:runtrol.reviewRuntimeRequests",
    "onCommand:runtrol.openNextWaiting",
    "onCommand:runtrol.switchSession",
    "onCommand:runtrol.arrangeConversationGrid",
    "onCommand:runtrol.startSession",
    "onCommand:runtrol.selectSession",
    "onCommand:runtrol.openConversation",
    "onCommand:runtrol.renameSession",
    "onCommand:runtrol.openWorkspace",
    "onCommand:runtrol.interrupt",
    "onCommand:runtrol.closeSession",
    "onCommand:runtrol.archiveConversation",
    "onCommand:runtrol.deleteConversation",
    "onCommand:runtrol.pinConversation",
    "onCommand:runtrol.unpinConversation",
    "onCommand:runtrol.enableAgentTools",
    "onCommand:runtrol.disableAgentTools",
    "onCommand:runtrol.moveProjectUp",
    "onCommand:runtrol.moveProjectDown"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runtrol",
          "title": "Runtrol",
          "icon": "resources/symbol.svg"
        }
      ]
    },
    "views": {
      "runtrol": [
        {
          "id": "runtrol.sidebar",
          "name": "Runtrol",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "runtrol.refresh",
        "title": "Refresh Conversations",
        "icon": "$(refresh)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.restartExtensionHost",
        "title": "Restart Extension Host",
        "icon": "$(debug-restart)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.checkProviderUpdates",
        "title": "Check Provider Updates",
        "icon": "$(cloud-download)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.fixService",
        "title": "Fix Coding Service...",
        "icon": "$(wrench)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.setUpServices",
        "title": "Set Up Coding Services",
        "icon": "$(add)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.remoteConnectionStatus",
        "title": "Remote Connection Status",
        "icon": "$(remote)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.pairPhone",
        "title": "Pair a Phone",
        "icon": "$(device-mobile)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.reviewPhonePairings",
        "title": "Review Phone Pairing Requests",
        "icon": "$(pass-filled)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.managePhones",
        "title": "Manage Paired Phones",
        "icon": "$(key)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.reviewIntegrations",
        "title": "Review Integration Requests",
        "icon": "$(shield)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.manageIntegrations",
        "title": "Manage Runtime Integrations",
        "icon": "$(key)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.reviewRuntimeRequests",
        "title": "Review Runtime Requests",
        "icon": "$(checklist)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.openNextWaiting",
        "title": "Open Next Waiting Conversation",
        "icon": "$(bell-dot)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.switchSession",
        "title": "Switch Conversation",
        "icon": "$(search)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.startSession",
        "title": "New Conversation",
        "icon": "$(add)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.selectSession",
        "title": "Open Conversation",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.openConversation",
        "title": "Show Open Conversation",
        "icon": "$(comment-discussion)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.renameSession",
        "title": "Rename Conversation",
        "icon": "$(edit)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.openProjectWorkspace",
        "title": "Open Project as Window",
        "category": "Runtrol",
        "icon": "$(link-external)"
      },
      {
        "command": "runtrol.openWorkspace",
        "title": "Open Conversation Project",
        "icon": "$(folder-opened)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.interrupt",
        "title": "Interrupt Turn",
        "icon": "$(debug-stop)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.closeSession",
        "title": "Close Conversation",
        "icon": "$(close)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.archiveConversation",
        "title": "Archive Conversation",
        "icon": "$(archive)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.deleteConversation",
        "title": "Delete Conversation",
        "icon": {
          "light": "resources/action-icons/trash.svg",
          "dark": "resources/action-icons/trash.svg"
        },
        "category": "Runtrol"
      },
      {
        "command": "runtrol.pinConversation",
        "title": "Pin Conversation",
        "icon": "$(pin)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.unpinConversation",
        "title": "Unpin Conversation",
        "icon": "$(pinned)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.newConversationInProject",
        "title": "New Conversation in Project",
        "icon": "$(add)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.deleteProjectConversations",
        "title": "Delete All Conversations in Project...",
        "icon": "$(trash)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.arrangeConversationGrid",
        "title": "Arrange Open Conversations in a Grid",
        "icon": "$(layout)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.createProject",
        "title": "Add Project",
        "icon": "$(folder-library)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.createProjectHere",
        "title": "Add This Folder as a Project",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.pinProject",
        "title": "Pin Project",
        "icon": "$(pin)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.unpinProject",
        "title": "Unpin Project",
        "icon": "$(pinned)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.enableAgentTools",
        "title": "Enable Agent Tools for This Project",
        "category": "Runtrol",
        "icon": "$(sparkle)"
      },
      {
        "command": "runtrol.disableAgentTools",
        "title": "Disable Agent Tools for This Project",
        "category": "Runtrol",
        "icon": "$(circle-slash)"
      },
      {
        "command": "runtrol.renameProject",
        "title": "Rename Project",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.removeProject",
        "title": "Remove Project",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.explainListing",
        "title": "Why Are Some Chats Not Listed?",
        "icon": "$(info)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.returnToPreviousProject",
        "title": "Back to Previous Project",
        "icon": "$(arrow-left)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.signInFromRow",
        "title": "Sign In to This Service",
        "category": "Runtrol",
        "icon": "$(key)"
      },
      {
        "command": "runtrol.allowFromRow",
        "title": "Allow (the service's own first allow option)",
        "category": "Runtrol",
        "icon": "$(check)"
      },
      {
        "command": "runtrol.declineFromRow",
        "title": "Decline (the service's own first decline option)",
        "category": "Runtrol",
        "icon": "$(circle-slash)"
      },
      {
        "command": "runtrol.answerFromRow",
        "title": "Answer the Question...",
        "category": "Runtrol",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "runtrol.switchProject",
        "title": "Switch Window to Project...",
        "icon": "$(folder-opened)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.startSessionWith",
        "title": "Start a Conversation With This Service",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.moveProjectUp",
        "title": "Move Project Up",
        "icon": "$(arrow-up)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.moveProjectDown",
        "title": "Move Project Down",
        "icon": "$(arrow-down)",
        "category": "Runtrol"
      },
      {
        "command": "runtrol.moreActions",
        "title": "More Actions...",
        "icon": "$(kebab-vertical)",
        "category": "Runtrol"
      }
    ],
    "keybindings": [
      {
        "command": "runtrol.openNextWaiting",
        "key": "ctrl+k ctrl+w",
        "mac": "cmd+k cmd+w",
        "when": "!terminalFocus"
      },
      {
        "command": "runtrol.switchSession",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "!terminalFocus"
      },
      {
        "command": "runtrol.startSession",
        "key": "ctrl+k ctrl+n",
        "mac": "cmd+k cmd+n",
        "when": "!terminalFocus"
      },
      {
        "command": "runtrol.openConversation",
        "key": "ctrl+k ctrl+o",
        "mac": "cmd+k cmd+o",
        "when": "!terminalFocus"
      },
      {
        "command": "runtrol.interrupt",
        "key": "ctrl+k ctrl+i",
        "mac": "cmd+k cmd+i",
        "when": "!editorTextFocus && !terminalFocus"
      },
      {
        "command": "runtrol.returnToPreviousProject",
        "key": "ctrl+k ctrl+b",
        "mac": "cmd+k cmd+b"
      },
      {
        "command": "runtrol.switchProject",
        "key": "ctrl+k ctrl+shift+p",
        "mac": "cmd+k cmd+shift+p"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "runtrol.selectSession",
          "when": "false"
        },
        {
          "command": "runtrol.newConversationInProject",
          "when": "false"
        },
        {
          "command": "runtrol.deleteProjectConversations",
          "when": "false"
        },
        {
          "command": "runtrol.createProjectHere",
          "when": "false"
        },
        {
          "command": "runtrol.renameProject",
          "when": "false"
        },
        {
          "command": "runtrol.removeProject",
          "when": "false"
        },
        {
          "command": "runtrol.archiveConversation",
          "when": "false"
        },
        {
          "command": "runtrol.deleteConversation",
          "when": "false"
        },
        {
          "command": "runtrol.pinConversation",
          "when": "false"
        },
        {
          "command": "runtrol.unpinConversation",
          "when": "false"
        },
        {
          "command": "runtrol.signInFromRow",
          "when": "false"
        },
        {
          "command": "runtrol.allowFromRow",
          "when": "false"
        },
        {
          "command": "runtrol.declineFromRow",
          "when": "false"
        },
        {
          "command": "runtrol.answerFromRow",
          "when": "false"
        },
        {
          "command": "runtrol.startSessionWith",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "runtrol.startSession",
          "when": "view == runtrol.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "runtrol.createProject",
          "when": "view == runtrol.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "runtrol.moreActions",
          "when": "view == runtrol.sidebar",
          "group": "navigation@2"
        }
      ]
    },
    "colors": [
      {
        "id": "runtrol.accent",
        "description": "Runtrol accent for primary sidebar actions.",
        "defaults": {
          "dark": "#F56565",
          "light": "#D94848",
          "highContrast": "#FF8A80",
          "highContrastLight": "#B42323"
        }
      }
    ],
    "configuration": {
      "title": "Runtrol",
      "properties": {
        "runtrol.corePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to a runtrol executable. The bundled core and PATH are discovered automatically when empty."
        },
        "runtrol.relayOrigin": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Exact HTTPS origin of the ciphertext relay. Empty disables phone connections. Changes apply to the running Core without ending sessions."
        }
      }
    }
  },
  "scripts": {
    "build": "node tooling/build.mjs",
    "check": "tsc --noEmit",
    "test": "node tooling/test.mjs",
    "test:host": "node tooling/extension-host.mjs",
    "package:native": "node tooling/package.mjs",
    "package:win32-x64": "node tooling/package.mjs win32-x64",
    "test:posix": "node tooling/posix-suite.mjs"
  },
  "devDependencies": {
    "@runtrol/runtime-client": "file:../../clients/typescript",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "~1.106.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.3-5",
    "esbuild": "^0.25.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.0"
  }
}
