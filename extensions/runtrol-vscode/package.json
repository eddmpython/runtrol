{
  "name": "runtrol-studio",
  "displayName": "Runtrol Studio",
  "description": "Control every local coding-agent CLI session from one VS Code window.",
  "version": "0.0.0",
  "publisher": "runtrol",
  "license": "SEE LICENSE IN resources/LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/eddmpython/runtrol.git"
  },
  "homepage": "https://eddmpython.github.io/runtrol/",
  "bugs": {
    "url": "https://github.com/eddmpython/runtrol/issues"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0B0D0F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "coding agent",
    "multi agent",
    "session",
    "workspace"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "activationEvents": [
    "onView:runtrol.sessions",
    "onView:runtrol.missions",
    "onView:runtrol.providers",
    "onCommand:runtrol.refresh",
    "onCommand:runtrol.checkProviderUpdates",
    "onCommand:runtrol.remoteConnectionStatus",
    "onCommand:runtrol.pairPhone",
    "onCommand:runtrol.reviewPhonePairings",
    "onCommand:runtrol.managePhones",
    "onCommand:runtrol.reviewIntegrations",
    "onCommand:runtrol.manageIntegrations",
    "onCommand:runtrol.reviewRuntimeRequests",
    "onCommand:runtrol.switchSession",
    "onCommand:runtrol.startSession",
    "onCommand:runtrol.startServiceChat",
    "onCommand:runtrol.selectSession",
    "onCommand:runtrol.openConversation",
    "onCommand:runtrol.renameSession",
    "onCommand:runtrol.openWorkspace",
    "onCommand:runtrol.interrupt",
    "onCommand:runtrol.closeSession",
    "onCommand:runtrol.validateMission",
    "onCommand:runtrol.registerMissionGate",
    "onCommand:runtrol.openMission",
    "onCommand:runtrol.startMission",
    "onCommand:runtrol.prepareMissionTask",
    "onCommand:runtrol.sendTaskInstruction",
    "onCommand:runtrol.verifyMissionTask",
    "onCommand:runtrol.retryMissionTask",
    "onCommand:runtrol.pauseMission",
    "onCommand:runtrol.resumeMission",
    "onCommand:runtrol.cancelMission",
    "onCommand:runtrol.completeMissionIntegration",
    "onCommand:runtrol.archiveMission",
    "onCommand:runtrol.openTaskSession",
    "onCommand:runtrol.proposeCapability",
    "onCommand:runtrol.capabilityInbox",
    "onCommand:runtrol.verifyCapability",
    "onCommand:runtrol.approveCapability",
    "onCommand:runtrol.rejectCapability",
    "onCommand:runtrol.quarantineCapability",
    "onCommand:runtrol.rollbackCapability",
    "onCommand:runtrol.archiveCapability"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runtrol",
          "title": "Runtrol",
          "icon": "resources/symbol.svg"
        }
      ]
    },
    "views": {
      "runtrol": [
        {
          "id": "runtrol.sessions",
          "name": "Chats"
        },
        {
          "id": "runtrol.missions",
          "name": "Missions"
        },
        {
          "id": "runtrol.providers",
          "name": "Installed CLIs"
        }
      ]
    },
    "commands": [
      {
        "command": "runtrol.refresh",
        "title": "Runtrol: Refresh Chats and Services",
        "icon": "$(refresh)"
      },
      {
        "command": "runtrol.checkProviderUpdates",
        "title": "Runtrol: Check Provider Updates",
        "icon": "$(cloud-download)"
      },
      {
        "command": "runtrol.remoteConnectionStatus",
        "title": "Runtrol: Remote Connection Status",
        "icon": "$(remote)"
      },
      {
        "command": "runtrol.pairPhone",
        "title": "Runtrol: Pair a Phone",
        "icon": "$(device-mobile)"
      },
      {
        "command": "runtrol.reviewPhonePairings",
        "title": "Runtrol: Review Phone Pairing Requests",
        "icon": "$(pass-filled)"
      },
      {
        "command": "runtrol.managePhones",
        "title": "Runtrol: Manage Paired Phones",
        "icon": "$(key)"
      },
      {
        "command": "runtrol.reviewIntegrations",
        "title": "Runtrol: Review Integration Requests",
        "icon": "$(shield)"
      },
      {
        "command": "runtrol.manageIntegrations",
        "title": "Runtrol: Manage Runtime Integrations",
        "icon": "$(key)"
      },
      {
        "command": "runtrol.reviewRuntimeRequests",
        "title": "Runtrol: Review Runtime Requests",
        "icon": "$(checklist)"
      },
      {
        "command": "runtrol.switchSession",
        "title": "Runtrol: Switch Chat",
        "icon": "$(search)"
      },
      {
        "command": "runtrol.startSession",
        "title": "Runtrol: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "runtrol.startServiceChat",
        "title": "Runtrol: New Chat with Service",
        "icon": "$(add)"
      },
      {
        "command": "runtrol.selectSession",
        "title": "Runtrol: Open Chat"
      },
      {
        "command": "runtrol.openConversation",
        "title": "Runtrol: Open Current Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "runtrol.renameSession",
        "title": "Runtrol: Rename Chat",
        "icon": "$(edit)"
      },
      {
        "command": "runtrol.openWorkspace",
        "title": "Runtrol: Open Chat Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "runtrol.interrupt",
        "title": "Runtrol: Interrupt Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "runtrol.closeSession",
        "title": "Runtrol: Close Chat",
        "icon": "$(close)"
      },
      {
        "command": "runtrol.validateMission",
        "title": "Runtrol: Validate Mission",
        "icon": "$(new-file)"
      },
      {
        "command": "runtrol.registerMissionGate",
        "title": "Runtrol: Register Mission Gate",
        "icon": "$(tools)"
      },
      {
        "command": "runtrol.openMission",
        "title": "Runtrol: Open Mission"
      },
      {
        "command": "runtrol.startMission",
        "title": "Runtrol: Start Reviewed Mission",
        "icon": "$(play)"
      },
      {
        "command": "runtrol.prepareMissionTask",
        "title": "Runtrol: Prepare Mission Task",
        "icon": "$(vm-running)"
      },
      {
        "command": "runtrol.sendTaskInstruction",
        "title": "Runtrol: Send Task Instruction",
        "icon": "$(send)"
      },
      {
        "command": "runtrol.verifyMissionTask",
        "title": "Runtrol: Verify Mission Task",
        "icon": "$(beaker)"
      },
      {
        "command": "runtrol.retryMissionTask",
        "title": "Runtrol: Retry Mission Task",
        "icon": "$(redo)"
      },
      {
        "command": "runtrol.pauseMission",
        "title": "Runtrol: Pause Mission",
        "icon": "$(debug-pause)"
      },
      {
        "command": "runtrol.resumeMission",
        "title": "Runtrol: Resume Mission Safely",
        "icon": "$(debug-continue)"
      },
      {
        "command": "runtrol.cancelMission",
        "title": "Runtrol: Cancel Mission",
        "icon": "$(debug-stop)"
      },
      {
        "command": "runtrol.completeMissionIntegration",
        "title": "Runtrol: Verify and Complete Mission Integration",
        "icon": "$(verified-filled)"
      },
      {
        "command": "runtrol.archiveMission",
        "title": "Runtrol: Archive Mission",
        "icon": "$(archive)"
      },
      {
        "command": "runtrol.openTaskSession",
        "title": "Runtrol: Open Task Session",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "runtrol.proposeCapability",
        "title": "Runtrol: Propose Project Capability",
        "icon": "$(new-folder)"
      },
      {
        "command": "runtrol.capabilityInbox",
        "title": "Runtrol: Open Capability Candidate Inbox",
        "icon": "$(inbox)"
      },
      {
        "command": "runtrol.verifyCapability",
        "title": "Runtrol: Verify Capability Candidate",
        "icon": "$(beaker)"
      },
      {
        "command": "runtrol.approveCapability",
        "title": "Runtrol: Approve Exact Capability Digest",
        "icon": "$(verified-filled)"
      },
      {
        "command": "runtrol.rejectCapability",
        "title": "Runtrol: Reject Capability Candidate",
        "icon": "$(close)"
      },
      {
        "command": "runtrol.quarantineCapability",
        "title": "Runtrol: Quarantine Capability",
        "icon": "$(shield)"
      },
      {
        "command": "runtrol.rollbackCapability",
        "title": "Runtrol: Roll Back Capability",
        "icon": "$(history)"
      },
      {
        "command": "runtrol.archiveCapability",
        "title": "Runtrol: Archive Capability",
        "icon": "$(archive)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "runtrol.startServiceChat",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "runtrol.openConversation",
          "when": "view == runtrol.sessions",
          "group": "navigation@0"
        },
        {
          "command": "runtrol.switchSession",
          "when": "view == runtrol.sessions",
          "group": "navigation@1"
        },
        {
          "command": "runtrol.startSession",
          "when": "view == runtrol.sessions",
          "group": "navigation@2"
        },
        {
          "command": "runtrol.refresh",
          "when": "view == runtrol.sessions || view == runtrol.providers",
          "group": "navigation@3"
        },
        {
          "command": "runtrol.checkProviderUpdates",
          "when": "view == runtrol.providers",
          "group": "navigation@2"
        },
        {
          "command": "runtrol.pairPhone",
          "when": "view == runtrol.providers",
          "group": "navigation@3"
        },
        {
          "command": "runtrol.managePhones",
          "when": "view == runtrol.providers",
          "group": "navigation@4"
        },
        {
          "command": "runtrol.reviewIntegrations",
          "when": "view == runtrol.providers",
          "group": "navigation@5"
        },
        {
          "command": "runtrol.manageIntegrations",
          "when": "view == runtrol.providers",
          "group": "navigation@6"
        },
        {
          "command": "runtrol.reviewRuntimeRequests",
          "when": "view == runtrol.sessions",
          "group": "navigation@4"
        },
        {
          "command": "runtrol.validateMission",
          "when": "view == runtrol.missions",
          "group": "navigation@1"
        },
        {
          "command": "runtrol.registerMissionGate",
          "when": "view == runtrol.missions",
          "group": "navigation@2"
        },
        {
          "command": "runtrol.refresh",
          "when": "view == runtrol.missions",
          "group": "navigation@3"
        },
        {
          "command": "runtrol.capabilityInbox",
          "when": "view == runtrol.missions",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "runtrol.startServiceChat",
          "when": "view == runtrol.sessions && viewItem == runtrol.service.ready",
          "group": "inline@1"
        },
        {
          "command": "runtrol.renameSession",
          "when": "view == runtrol.sessions && viewItem == runtrol.session",
          "group": "inline@1"
        },
        {
          "command": "runtrol.openWorkspace",
          "when": "view == runtrol.sessions && viewItem == runtrol.session",
          "group": "inline@2"
        },
        {
          "command": "runtrol.closeSession",
          "when": "view == runtrol.sessions && viewItem == runtrol.session",
          "group": "inline@3"
        },
        {
          "command": "runtrol.startMission",
          "when": "view == runtrol.missions && viewItem == runtrol.mission.validated",
          "group": "inline@1"
        },
        {
          "command": "runtrol.pauseMission",
          "when": "view == runtrol.missions && viewItem == runtrol.mission.running",
          "group": "inline@2"
        },
        {
          "command": "runtrol.resumeMission",
          "when": "view == runtrol.missions && viewItem == runtrol.mission.paused",
          "group": "inline@2"
        },
        {
          "command": "runtrol.cancelMission",
          "when": "view == runtrol.missions && (viewItem == runtrol.mission.running || viewItem == runtrol.mission.paused || viewItem == runtrol.mission.blocked)",
          "group": "inline@3"
        },
        {
          "command": "runtrol.completeMissionIntegration",
          "when": "view == runtrol.missions && viewItem == runtrol.mission.integrating",
          "group": "inline@1"
        },
        {
          "command": "runtrol.archiveMission",
          "when": "view == runtrol.missions && (viewItem == runtrol.mission.completed || viewItem == runtrol.mission.failed || viewItem == runtrol.mission.cancelled)",
          "group": "inline@2"
        },
        {
          "command": "runtrol.prepareMissionTask",
          "when": "view == runtrol.missions && viewItem == runtrol.missionTask.reserved",
          "group": "inline@1"
        },
        {
          "command": "runtrol.sendTaskInstruction",
          "when": "view == runtrol.missions && viewItem == runtrol.missionTask.awaitingInput.session",
          "group": "inline@1"
        },
        {
          "command": "runtrol.verifyMissionTask",
          "when": "view == runtrol.missions && viewItem == runtrol.missionTask.running.session",
          "group": "inline@1"
        },
        {
          "command": "runtrol.retryMissionTask",
          "when": "view == runtrol.missions && (viewItem == runtrol.missionTask.retryable || viewItem == runtrol.missionTask.retryable.session)",
          "group": "inline@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "runtrol.sessions",
        "contents": "No installed coding-agent services are available.\n[Refresh services](command:runtrol.refresh)"
      }
    ],
    "configuration": {
      "title": "Runtrol",
      "properties": {
        "runtrol.corePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to a runtrol executable. The bundled core and PATH are discovered automatically when empty."
        },
        "runtrol.followWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Open the selected session's workspace or worktree in this window."
        },
        "runtrol.relayOrigin": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Exact HTTPS origin of the ciphertext relay. Empty disables phone connections. Changes apply to the running Core without ending sessions."
        }
      }
    }
  },
  "scripts": {
    "build": "node tooling/build.mjs",
    "check": "tsc --noEmit",
    "test": "node tooling/test.mjs",
    "test:host": "node tooling/extension-host.mjs",
    "package:native": "node tooling/package.mjs",
    "package:win32-x64": "node tooling/package.mjs win32-x64"
  },
  "devDependencies": {
    "@runtrol/runtime-client": "file:../../clients/typescript",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.3-5",
    "esbuild": "^0.25.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.0"
  }
}
