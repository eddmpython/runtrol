        },
        {
          "command": "runtrol.declineFromRow",
          "when": "false"
        },
        {
          "command": "runtrol.answerFromRow",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "runtrol.armMissionAutoFlight",
          "when": "view == runtrol.missions",
          "group": "navigation@0"
        },
        {
          "command": "runtrol.continueReadyMissions",
          "when": "view == runtrol.missions",
          "group": "navigation@1"
        },
        {
          "command": "runtrol.startSession",
          "when": "view == runtrol.sessions",
          "group": "navigation@0"
        },
        {
          "command": "runtrol.createProject",
          "when": "view == runtrol.sessions",
          "group": "navigation@1"
        },
        {
          "command": "runtrol.newProjectFolder",
          "when": "view == runtrol.sessions",
          "group": "1_project@1"
